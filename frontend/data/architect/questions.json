       "booking",
       "saas",
       "dashboard",
       "management-system",
       "marketplace",
       "other"
      ]
     },
     {
      "s": "capture",
      "is": "bookings"
     }
    ]
   },
   "learn": "authentication-and-authorization",
   "tier": "core"
  },
  {
   "id": "sensitive_data",
   "type": "single",
   "signal": "sensitive_data",
   "text": "¿Qué tipo de datos va a manejar?",
   "why": "Define cuánto rigor de seguridad se justifica. No todo proyecto necesita el mismo nivel.",
   "offer": [
    "none",
    "personal",
    "financial",
    "regulated"
   ],
   "show_if": {
    "any": [
     {
      "s": "auth",
      "not": "none"
     },
     {
      "s": "payments",
      "not": "none"
     }
    ]
   },
   "learn": "quality-security",
   "tier": "core"
  },
  {
   "id": "data_shape",
   "type": "single",
   "signal": "data_shape",
   "text": "¿Cómo son los datos?",
   "why": "Con relaciones claras (pedidos, clientes, productos), una base relacional es lo natural. Si la estructura es muy variable, otro modelo puede encajar.",
   "offer": [
    "relational",
    "flexible"
   ],
   "show_if": {
    "any": [
     {
      "s": "auth",
