 "questions": [
  {
   "id": "idea",
   "type": "text",
   "text": "¿Qué querés construir? Contalo en una o dos frases.",
   "why": "Es el punto de partida del resumen del proyecto. No cambia las recomendaciones: eso lo hacen las respuestas que siguen.",
   "placeholder": "Por ejemplo: una tienda online para vender mis productos artesanales",
   "max": 400,
   "tier": "core"
  },
  {
   "id": "users",
   "type": "text",
   "text": "¿Quiénes lo van a usar y qué problema les resuelve?",
   "why": "Define el objetivo y los usuarios del proyecto. Sirve para el resumen y para los prompts que se generan después.",
   "placeholder": "Por ejemplo: personas que compran regalos y hoy me escriben por mensajes",
   "max": 400,
   "tier": "core"
  },
  {
   "id": "product",
   "type": "single",
   "signal": "product",
   "text": "¿Qué se parece más a lo que querés construir?",
   "why": "El tipo de producto decide qué preguntas siguen y qué suposiciones razonables se pueden hacer.",
   "offer": [
    "landing",
    "institutional-site",
    "portfolio",
    "ecommerce",
    "booking",
    "saas",
    "dashboard",
    "management-system",
    "marketplace",
    "other"
   ],
   "help": {
    "landing": "Una página con un solo objetivo: que alguien haga una cosa.",
    "institutional-site": "La presencia online de una organización, con varias secciones.",
    "portfolio": "Mostrar tu trabajo y quién sos: proyectos, casos y cómo contactarte.",
    "ecommerce": "Una tienda con carrito y pagos.",
    "booking": "Que la gente reserve o saque un turno para un servicio o un lugar.",
    "saas": "Un software por suscripción, con cuentas y datos por cliente.",
    "dashboard": "Una interfaz para ver y entender datos.",
    "management-system": "Un sistema interno para operar un negocio.",
    "marketplace": "Una plataforma que conecta vendedores y compradores.",
    "other": "Si no encaja o no estás seguro, seguimos con más preguntas."
   },
   "tier": "core"
  },
  {
   "id": "content_edit",
   "type": "single",
   "signal": "content_edit",
   "text": "¿Cada cuánto va a cambiar el contenido?",
   "why": "Si casi no cambia, alcanza con archivos estáticos. Si cambia seguido, conviene poder regenerarlo o editarlo sin tocar código.",
   "offer": [
    "never",
    "sometimes",
    "often"
   ],
   "show_if": {
    "s": "product",
    "in": [
     "landing",
     "institutional-site",
     "portfolio"
    ]
   },
   "tier": "core"
  },
  {
   "id": "capture",
   "type": "single",
   "signal": "capture",
   "text": "Además de leer, ¿qué tiene que poder hacer la persona?",
   "why": "Un formulario se resuelve con un servicio externo. Reservas propias ya necesitan datos y reglas propias.",
   "offer": [
    "none",
    "contact",
    "bookings"
   ],
   "show_if": {
    "s": "product",
    "in": [
     "landing",
     "institutional-site",
     "portfolio"
    ]
   },
   "tier": "core"
  },
  {
   "id": "catalog",
   "type": "single",
   "signal": "catalog",
   "text": "¿Qué tamaño va a tener el catálogo?",
   "why": "Un catálogo chico se puede pregenerar; uno grande o muy cambiante pide otras estrategias y búsqueda.",
   "offer": [
    "small",
    "medium",
    "large"
   ],
   "show_if": {
    "s": "product",
    "in": [
     "ecommerce",
     "marketplace"
    ]
   },
   "tier": "core"
  },
  {
   "id": "payments",
   "type": "single",
   "signal": "payments",
   "text": "¿Se cobra dentro del producto?",
   "why": "Los pagos suben mucho el nivel de exigencia en seguridad, consistencia de datos y confiabilidad.",
   "offer": [
    "none",
    "simple",
    "split"
   ],
   "show_if": {
    "s": "product",
    "in": [
     "ecommerce",
     "booking",
     "saas",
     "marketplace",
     "other"
    ]
   },
   "help": {
    "simple": "El pago lo gestiona un proveedor externo; el producto cobra a sus clientes.",
    "split": "Hay que repartir el dinero entre varias partes (por ejemplo, vendedores y la plataforma)."
   },
   "tier": "core"
  },
  {
   "id": "auth",
   "type": "single",
   "signal": "auth",
   "text": "¿Hay cuentas de usuario y permisos?",
   "why": "Con cuentas aparecen la autenticación, la autorización y los datos por persona: el origen de la mayoría de los riesgos serios.",
